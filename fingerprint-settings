        self.toasts.set_child(tv)
        self.set_content(self.toasts)

        # --- отпечатки
        self.g_fingers = Adw.PreferencesGroup(title="Отпечатки",
                                              description="Записанные пальцы вашей учётной записи")
        self.add_btn = Gtk.Button(label="Добавить", valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
        self.add_btn.connect("clicked", self.on_add)
        self.g_fingers.set_header_suffix(self.add_btn)
        self.page.add(self.g_fingers)
        self.finger_rows = []

        self.verify_row = Adw.ActionRow(title="Проверить отпечаток", subtitle="Нажмите «Проверить» и приложите палец")
        self.verify_btn = Gtk.Button(label="Проверить", valign=Gtk.Align.CENTER)
        self.verify_btn.connect("clicked", self.on_verify)
        self.verify_row.add_suffix(self.verify_btn)

        # --- где применять
        g = Adw.PreferencesGroup(title="Где входить по отпечатку",
                                 description="Пароль остаётся запасным вариантом везде")
        self.sw_login = self._switch(g, "Вход в систему", "Экран входа после включения или выхода",
                                     "system-users-symbolic", lambda on: self.set_root_zone("login", on))
        self.sw_lock = self._switch(g, "Разблокировка экрана", "Экран блокировки GNOME",
                                    "system-lock-screen-symbolic", self.set_lock)
        self.sw_term = self._switch(g, "Терминал", "sudo, sudo -i и su",
                                    "utilities-terminal-symbolic", lambda on: self.set_root_zone("terminal", on))
        self.sw_polkit = self._switch(g, "Запросы прав администратора",
                                      "Окна «Требуется аутентификация» в приложениях",
                                      "security-high-symbolic", lambda on: self.set_root_zone("polkit", on))
        self.page.add(g)

        # --- сканер
        self.g_dev = Adw.PreferencesGroup(title="Сканер")
        self.dev_row = Adw.ActionRow(title="Сканер", icon_name="auth-fingerprint-symbolic")
        self.g_dev.add(self.dev_row)
        self.dac_row = Adw.ActionRow(title="Усиление изображения",
                                     subtitle="Подбирается под конкретный экземпляр сканера FT9366")
        tune = Gtk.Button(label="Подобрать заново", valign=Gtk.Align.CENTER)
        tune.connect("clicked", self.on_tune)
        self.dac_row.add_suffix(tune)
        self.g_dev.add(self.dac_row)
        self.page.add(self.g_dev)

        self.lock_settings = Gio.Settings.new("org.gnome.login-screen")
        self.refresh()

    # helpers
    def _switch(self, group, title, subtitle, icon, handler):
        row = Adw.SwitchRow(title=title, subtitle=subtitle, icon_name=icon)
        row._handler = handler
        row.connect("notify::active", self._on_switch)
        group.add(row)
        return row

    def _on_switch(self, row, _pspec):
        if self.busy:
            return
        row._handler(row.get_active())

    def _set_quiet(self, row, value):
        self.busy = True
        row.set_active(value)
        self.busy = False

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

    # data
    def refresh(self):
        self._set_quiet(self.sw_login, zone_login())
        self._set_quiet(self.sw_lock, self.lock_settings.get_boolean("enable-fingerprint-authentication"))
        self._set_quiet(self.sw_term, zone_terminal())
        self._set_quiet(self.sw_polkit, zone_polkit())
        self.banner.set_revealed(not authselect_ok())

        for r in self.finger_rows:
            self.g_fingers.remove(r)
        self.finger_rows = []

        try:
            self.fp.connect()
            name = self.fp.prop("name", "сканер")
            self.dev_row.set_subtitle(f"{name}\n{libfprint_version()}")
            fingers = self.fp.enrolled()
            self.add_btn.set_sensitive(True)
        except GLib.Error as e:
            self.dev_row.set_subtitle("Сканер не найден: " + e.message.split(":")[-1].strip())
            fingers = []
            self.add_btn.set_sensitive(False)

        is_ft = "FT9366" in (self.fp.prop("name", "") or "")
        self.dac_row.set_visible(is_ft)
        if is_ft:
            dac = current_dac()
            self.dac_row.set_title(f"Усиление изображения: {dac}" if dac else "Усиление изображения: не подобрано")

        n = len(fingers)
        word = "палец" if n % 10 == 1 and n % 100 != 11 else \
               "пальца" if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14 else "пальцев"
        self.g_fingers.set_description(f"Записано {n} {word} для {self.fp.user}" if n
                                       else "Запишите хотя бы один палец, чтобы входить по отпечатку")
        if not fingers:
            r = Adw.ActionRow(title="Нет записанных отпечатков", subtitle="Нажмите «Добавить»")
            self._add_finger_row(r)
        for f in fingers:
            r = Adw.ActionRow(title=FINGER_NAME.get(f, f), icon_name="auth-fingerprint-symbolic")
            b = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER,
                           tooltip_text="Удалить", css_classes=["flat"])
            b.connect("clicked", self.on_delete, f)
            r.add_suffix(b)
            self._add_finger_row(r)
        if fingers:
            self._add_finger_row(self.verify_row)

    def _add_finger_row(self, row):
        self.g_fingers.add(row)
        self.finger_rows.append(row)

    # fingers
    def on_add(self, _btn):
        try:
            taken = set(self.fp.enrolled())
        except GLib.Error:
            taken = set()
        free = [(k, v) for k, v in FINGERS if k not in taken]
        if not free:
            self.toast("Записаны все пальцы")
            return
        dlg = Adw.AlertDialog(heading="Какой палец записать?",
                              body="Понадобится около 20 касаний. Прикладывайте палец легко и каждый раз "
                                   "чуть сдвигайте.")
        dd = Gtk.DropDown.new_from_strings([v for _, v in free])
        dlg.set_extra_child(dd)
        dlg.add_response("cancel", "Отмена")
        dlg.add_response("go", "Начать")
        dlg.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def on_resp(_d, resp):
            if resp == "go":
                finger = free[dd.get_selected()][0]
                ed = EnrollDialog(self.fp, finger, self.refresh)
                ed.present(self)
                ed.start()
        dlg.connect("response", on_resp)
        dlg.present(self)

    def on_delete(self, _btn, finger):
        dlg = Adw.AlertDialog(heading="Удалить отпечаток?", body=FINGER_NAME.get(finger, finger))
        dlg.add_response("cancel", "Отмена")
        dlg.add_response("del", "Удалить")
        dlg.set_response_appearance("del", Adw.ResponseAppearance.DESTRUCTIVE)

        def on_resp(_d, resp):
            if resp != "del":
                return
            try:
                self.fp.delete(finger)
                self.toast("Отпечаток удалён")
            except GLib.Error as e:
                self.toast("Не удалось удалить: " + e.message.split(":")[-1].strip())
            self.refresh()
        dlg.connect("response", on_resp)
        dlg.present(self)

    def on_verify(self, _btn):
        if self.verify_sig:
            return
        try:
            self.fp.claim()
            self.verify_sig = self.fp.dev.connect("g-signal", self._on_verify_signal)
            self.fp._call("VerifyStart", GLib.Variant("(s)", ("any",)))
            self.verify_row.set_subtitle("Приложите палец…")
            self.verify_btn.set_sensitive(False)
        except GLib.Error as e:
            self._verify_end()
            self.verify_row.set_subtitle("Ошибка: " + e.message.split(":")[-1].strip())

    def _on_verify_signal(self, _p, _s, name, params):
        if name != "VerifyStatus":
            return
        result, done = params.unpack()
        self.verify_row.set_subtitle(VERIFY_MSG.get(result, result))
        if done:
            self._verify_end()

    def _verify_end(self):
        if self.verify_sig:
            self.fp.dev.disconnect(self.verify_sig)
            self.verify_sig = None
        try:
            self.fp._call("VerifyStop")
        except GLib.Error:
            pass
        self.fp.release()
        self.verify_btn.set_sensitive(True)

    # zones
    def set_lock(self, on):
        self.lock_settings.set_boolean("enable-fingerprint-authentication", on)
        self.toast("Разблокировка по отпечатку " + ("включена" if on else "выключена"))

    def set_root_zone(self, zone, on):
        row = {"login": self.sw_login, "terminal": self.sw_term, "polkit": self.sw_polkit}[zone]
        row.set_sensitive(False)
        proc = Gio.Subprocess.new(["pkexec", HELPER, zone, "on" if on else "off"],
                                  Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)

        def done(p, res):
            try:
                _ok, out, _err = p.communicate_utf8_finish(res)
            except GLib.Error as e:
                out = e.message
            row.set_sensitive(True)
            if p.get_successful():
                self.toast(f"{row.get_title()}: отпечаток " + ("включён" if on else "выключен"))
            else:
                msg = (out or "").strip().splitlines()[-1:] or ["отменено"]
                self.toast("Не изменено: " + msg[0])
            self.refresh()
        proc.communicate_utf8_async(None, None, done)

    # scanner
    def on_tune(self, _btn):
        cmd = f"sudo {TUNER} {self.fp.user}; echo; read -r -p 'Нажмите Enter, чтобы закрыть' _"
        try:
            Gio.Subprocess.new(["ptyxis", "--new-window", "--", "bash", "-c", cmd], Gio.SubprocessFlags.NONE)
            self.toast("Подбор усиления открыт в терминале. После него нажмите «Обновить».")
        except GLib.Error as e:
            self.toast("Не удалось открыть терминал: " + e.message)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == "__main__":
    raise SystemExit(App().run(None))
