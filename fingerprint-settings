# ---------- fprintd ----------------------------------------------------------

class Fprint:
    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.user = pwd.getpwuid(os.getuid()).pw_name
        self.dev = None

    def connect(self):
        mgr = Gio.DBusProxy.new_sync(self.bus, 0, None, FP_BUS, "/net/reactivated/Fprint/Manager",
                                     FP_BUS + ".Manager", None)
        path = mgr.call_sync("GetDefaultDevice", None, 0, -1, None).unpack()[0]
        self.dev = Gio.DBusProxy.new_sync(self.bus, 0, None, FP_BUS, path, FP_BUS + ".Device", None)
        return self.dev

    def prop(self, name, default=None):
        v = self.dev.get_cached_property(name) if self.dev else None
        return v.unpack() if v is not None else default

    def _call(self, method, args=None, timeout=-1):
        return self.dev.call_sync(method, args, 0, timeout, None)

    def enrolled(self):
        try:
            return list(self._call("ListEnrolledFingers", GLib.Variant("(s)", (self.user,))).unpack()[0])
        except GLib.Error as e:
            if "NoEnrolledPrints" in e.message:
                return []
            raise

    def claim(self):
        self._call("Claim", GLib.Variant("(s)", ("",)))

    def release(self):
        try:
            self._call("Release")
        except GLib.Error:
            pass

    def delete(self, finger):
        self.claim()
        try:
            self._call("DeleteEnrolledFinger", GLib.Variant("(s)", (finger,)))
        finally:
            self.release()


# ---------- системные настройки (чтение без root) ----------------------------

def _read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def zone_terminal():
    return re.search(r"^auth\s+include\s+system-auth\s*$", _read("/etc/pam.d/sudo"), re.M) is not None


def zone_polkit():
    own = _read("/etc/pam.d/polkit-1")
    return not ("fingerprint-settings" in own and "password-auth" in own)


def zone_login():
    return "enable-fingerprint-authentication=false" not in _read("/etc/dconf/db/gdm.d/95-fingerprint-settings")


def authselect_ok():
    try:
        out = subprocess.run(["authselect", "current"], capture_output=True, text=True, timeout=5).stdout
        return "with-fingerprint" in out
    except (OSError, subprocess.SubprocessError):
        return True


def current_dac():
    m = re.search(r"FT9366_IMG_DAC=(0x[0-9a-fA-F]+)", _read(DROPIN))
    return m.group(1) if m else None


def libfprint_version():
    try:
        return subprocess.run(["rpm", "-q", "libfprint"], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


