def _accent_rgba():
    try:
        return Adw.StyleManager.get_default().get_accent_color_rgba()
    except (AttributeError, TypeError):
        c = Gdk.RGBA()
        c.parse("#3584e4")
        return c


class Ring(Gtk.Widget):
    """Рисует только кольцо; значок кладётся сверху через Gtk.Overlay."""
    SIZE, WIDTH = 176, 10

    def __init__(self):
        super().__init__()
        self.value = 0.0
        self.state = "normal"          # normal | success | error
        self.set_size_request(self.SIZE, self.SIZE)
        self.anim = None

    def set_value(self, value, animate=True):
        value = max(0.0, min(1.0, value))
        if self.anim:
            self.anim.skip()
        if not animate:
            self.value = value
            self.queue_draw()
            return
        target = Adw.CallbackAnimationTarget.new(self._anim_step)
        self.anim = Adw.TimedAnimation.new(self, self.value, value, 300, target)
        self.anim.set_easing(Adw.Easing.EASE_OUT_CUBIC)
        self.anim.play()

    def _anim_step(self, v):
        self.value = v
        self.queue_draw()

    def set_state(self, state):
        self.state = state
        self.queue_draw()

    def do_snapshot(self, snap):
        w, h = self.get_width(), self.get_height()
        r = min(w, h) / 2 - self.WIDTH / 2 - 1
        cx, cy = w / 2, h / 2
        stroke = Gsk.Stroke.new(self.WIDTH)
        stroke.set_line_cap(Gsk.LineCap.ROUND)

        track = self.get_color()
        track.alpha = 0.12
        pb = Gsk.PathBuilder.new()
        pb.add_circle(Graphene.Point().init(cx, cy), r)
        snap.append_stroke(pb.to_path(), stroke, track)

        if self.value > 0.001:
            color = _accent_rgba()
            if self.state == "error":
                color = Gdk.RGBA()
                color.parse("#e01b24")
            elif self.state == "success":
                color = Gdk.RGBA()
                color.parse("#2ec27e")
            pb = Gsk.PathBuilder.new()
            if self.value >= 0.999:
                pb.add_circle(Graphene.Point().init(cx, cy), r)
            else:
                a0 = -math.pi / 2
                a1 = a0 + 2 * math.pi * self.value
                pb.move_to(cx + r * math.cos(a0), cy + r * math.sin(a0))
                pb.svg_arc_to(r, r, 0, self.value > 0.5, True, cx + r * math.cos(a1), cy + r * math.sin(a1))
            snap.append_stroke(pb.to_path(), stroke, color)


class ProgressRing(Gtk.Overlay):
    """Кольцо прогресса вокруг значка отпечатка (как в «Настройках» GNOME)."""

    ICONS = {"normal": "auth-fingerprint-symbolic", "success": "object-select-symbolic",
             "error": "dialog-warning-symbolic"}

    def __init__(self):
        super().__init__(halign=Gtk.Align.CENTER)
        self.ring = Ring()
        self.set_child(self.ring)
        self.icon = Gtk.Image(icon_name=self.ICONS["normal"], pixel_size=80, css_classes=["dim-label"],
                              halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.add_overlay(self.icon)

    @property
    def value(self):
        return self.ring.value

    def set_value(self, value, animate=True):
        self.ring.set_value(value, animate)

    def set_state(self, state):
        self.ring.set_state(state)
        self.icon.set_from_icon_name(self.ICONS[state])
        self.icon.set_css_classes({"normal": ["accent"], "success": ["success"], "error": ["error"]}[state])


class EnrollDialog(Adw.Dialog):
    RETRY = {"enroll-retry-scan", "enroll-swipe-too-short", "enroll-finger-not-centered",
             "enroll-remove-and-retry"}

    def __init__(self, fp, finger, on_done):
        super().__init__(title="Запись отпечатка", content_width=400)
        self.fp, self.finger, self.on_done = fp, finger, on_done
        self.stages = max(1, int(fp.prop("num-enroll-stages", 10) or 10))
        self.passed = 0
        self.sig = None
        self.finished = False

        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      margin_top=12, margin_bottom=12, margin_start=32, margin_end=32)
        self.ring = ProgressRing()
        self.ring.set_margin_bottom(18)
        box.append(self.ring)
        box.append(Gtk.Label(label=FINGER_NAME.get(finger, finger), css_classes=["title-2"]))
        self.counter = Gtk.Label(label=f"0 из {self.stages}", css_classes=["title-4", "numeric", "dim-label"])
        box.append(self.counter)
        self.msg = Gtk.Label(label="Приложите палец к сканеру на секунду и уберите.\n"
                                   "Касайтесь легко — сканер в кнопке питания.",
                             wrap=True, justify=Gtk.Justification.CENTER, lines=2,
                             height_request=72, valign=Gtk.Align.START, margin_top=6)
        box.append(self.msg)
        tv.set_content(box)

        self.button = Gtk.Button(label="Отмена", halign=Gtk.Align.CENTER, css_classes=["pill"],
                                 margin_top=6, margin_bottom=24)
        self.button.connect("clicked", lambda *_: self.close())
        tv.add_bottom_bar(self.button)

        self.set_child(tv)
        self.connect("closed", self._on_closed)

    def _say(self, text, kind=None):
        self.msg.set_label(text)
        self.msg.set_css_classes([kind] if kind else [])

    def start(self):
        try:
            self.fp.claim()
            self.sig = self.fp.dev.connect("g-signal", self._on_signal)
            self.fp._call("EnrollStart", GLib.Variant("(s)", (self.finger,)))
            self.ring.set_state("normal")
        except GLib.Error as e:
            self._finish("Не удалось начать запись: " + e.message.split(":")[-1].strip(), ok=False)

    def _on_signal(self, _proxy, _sender, name, params):
        if name != "EnrollStatus":
            return
        result, done = params.unpack()
        if result == "enroll-completed":
            self.passed = self.stages
            self.counter.set_label(f"{self.stages} из {self.stages}")
            self.ring.set_value(1.0)
            self._finish("Отпечаток записан", ok=True)
            return
        if result == "enroll-stage-passed":
            self.passed = min(self.passed + 1, self.stages)
            self.ring.set_value(self.passed / self.stages)
            self.counter.set_label(f"{self.passed} из {self.stages}")
            self._say(ENROLL_MSG[result])
        elif result in self.RETRY:
            self._say(ENROLL_MSG.get(result, result), "warning")
        else:
            self._say(ENROLL_MSG.get(result, result), "error")
        if done:
            self._finish(ENROLL_MSG.get(result, result), ok=False)

    def _finish(self, text, ok):
        if self.finished:
            return
        self.finished = True
        self._stop()
        self.ring.set_state("success" if ok else "error")
        if not ok and self.ring.value < 0.001:
            self.ring.set_value(1.0, animate=False)
        self._say(text, "success" if ok else "error")
        self.button.set_label("Готово" if ok else "Закрыть")
        self.button.add_css_class("suggested-action")
        self.on_done()
        if ok:
            GLib.timeout_add(1500, lambda: (self.close(), False)[1])

    def _stop(self):
        if self.sig:
            self.fp.dev.disconnect(self.sig)
            self.sig = None
        try:
            self.fp._call("EnrollStop")
        except GLib.Error:
            pass
        self.fp.release()

    def _on_closed(self, *_):
        if not self.finished:
            self.finished = True
            self._stop()
            self.on_done()


