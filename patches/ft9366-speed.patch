+
+Ft9366Template *
+ft9366_template_new (const guint8 * const *images, guint n)
+{
+  Ft9366Template *tpl = g_new0 (Ft9366Template, 1);
+  FeaturesJob fj;
 
+  template_reserve (tpl, MAX (n, 1));
+  fj = (FeaturesJob) { images, tpl->features };
+  run_parallel (n, features_job, &fj);
+  tpl->n = n;
+  template_link (tpl, 0);
   return tpl;
 }
 
+void
+ft9366_template_add (Ft9366Template *tpl, Ft9366Features *features)
+{
+  if (tpl->n == tpl->cap)
+    template_reserve (tpl, tpl->cap * 2);
+  tpl->features[tpl->n++] = features;
+  template_link (tpl, tpl->n - 1);
+}
+
+guint
+ft9366_template_size (const Ft9366Template *tpl)
+{
+  return tpl->n;
+}
